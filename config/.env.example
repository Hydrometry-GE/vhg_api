# API connection. Placeholder values are sufficient for configuration tests.
VHG_SERVER=example.tetraedrehost.ch
VHG_USERNAME=test_user
VHG_DOSSIER_ID=12345
VHG_ENCRYPTED_PASSWORD=test_password

# Optional default root for relative destinations in sources.csv.
# Absolute destinations (for example D:/..., S:/..., /srv/..., or //server/share/...)
# bypass this root. Leave it empty when every destination is absolute.
DATA_ROOT=D:/Hydrometrie

# Runtime logs.
VHG_LOG_DIR=C:/temp/vhg_api_test/runtime/logs

# Proxy addresses. They are used only when proxy.enabled is true in settings.yml.
HTTP_PROXY=
HTTPS_PROXY=


# Optional TLS CA bundle (PEM). Leave empty for normal HTTPS verification.
# On institutional networks with HTTPS inspection, IT can provide the trusted
# CA certificate/bundle path, for example C:/certs/institution-ca.pem.
VHG_CA_BUNDLE=
